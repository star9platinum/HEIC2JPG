#!/bin/bash

cat >/dev/null
if [ -n "${HEIC2JPG_TEST_CALL_LOG:-}" ]; then
  printf 'osascript\n' >> "$HEIC2JPG_TEST_CALL_LOG"
fi

if [ "${HEIC2JPG_PICKER_ERROR:-0}" = '1' ]; then
  exit 1
fi
if [ "${HEIC2JPG_PICKER_CANCEL:-0}" = '1' ]; then
  printf '\n'
  exit 0
fi

if [ -n "${HEIC2JPG_PICKER_PATHS:-}" ]; then
  printf '%s\n' "$HEIC2JPG_PICKER_PATHS"
else
  printf '%s\n' "${HEIC2JPG_PICKER_PATH:-}"
fi
